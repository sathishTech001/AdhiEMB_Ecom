# ==============================================================================
# AdhiEMB Production Environment Template (.env.prod.example)
# Copy this file to .env.prod (or export variables in CI/CD / host environment)
# ==============================================================================

# AWS RDS Database Configuration
DB_URL=jdbc:mysql://<RDS-ENDPOINT>:3306/adhiemb_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=admin
DB_PASSWORD=CHANGE_ME

# Security & Authentication (JWT Secret must be at least 256 bits / 32+ characters)
JWT_SECRET=CHANGE_ME

# AWS S3 Storage & Region Configuration (IAM Instance Profile on EC2)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=adhiemb-ecom-fstore

# Public Web Server Port (Default: 80)
PORT=80
